# ============================================================
# Stickman Studio — zero-cost/default configuration
# ============================================================

# ---------- LLM provider router ----------
# Providers are tried left-to-right. Missing API keys are skipped.
# This prevents a Gemini 503/outage from killing the whole pipeline.
LLM_PROVIDERS=gemini,groq,openrouter

# Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq free plan: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter free router: https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ---------- Image generation ----------
IMAGE_PROVIDER=pollinations
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=flux
IMAGE_WIDTH=1280
IMAGE_HEIGHT=720
IMAGE_FALLBACK_PLACEHOLDER=1

# ---------- Local video generation ----------
SCENE_COUNT=5
VIDEO_SECONDS=5
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY=3
LOG_LEVEL=INFO

# ---------- Optional YouTube upload ----------
# Put your OAuth desktop client file at ./client_secrets.json.

# ---------- Optional paid Vertex/Veo mode ----------
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GCS_STAGING_BUCKET=
IMAGEN_GENERATE_MODEL=imagen-3.0-generate-002
IMAGEN_CAPABILITY_MODEL=imagen-3.0-capability-001
VEO_MODEL=veo-2.0-generate-001

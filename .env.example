# ============================================================
# Stickman Studio — zero-cost/default configuration
# ============================================================

# ---------- Free Gemini API ----------
# Get a Gemini API key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- Image generation ----------
# pollinations = remote image generation (best-effort free endpoint)
# placeholder = fully local fallback for pipeline testing
IMAGE_PROVIDER=pollinations
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=flux
IMAGE_WIDTH=1280
IMAGE_HEIGHT=720
# If Pollinations is unavailable, create simple local stickman images.
IMAGE_FALLBACK_PLACEHOLDER=1

# ---------- Local video generation ----------
SCENE_COUNT=5
VIDEO_SECONDS=5
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY=3
LOG_LEVEL=INFO

# ---------- Optional YouTube upload ----------
# Put your OAuth desktop client file at ./client_secrets.json.
# YouTube upload does not require Vertex AI or a GCS staging bucket.

# ---------- Optional paid Vertex/Veo mode ----------
# Leave all of these blank for zero-cost slideshow mode.
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GCS_STAGING_BUCKET=
IMAGEN_GENERATE_MODEL=imagen-3.0-generate-002
IMAGEN_CAPABILITY_MODEL=imagen-3.0-capability-001
VEO_MODEL=veo-2.0-generate-001
